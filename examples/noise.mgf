; noise.mgf — domain-warped fbm, the classic procedural-texture trick.

canvas 1280, 720

y_loop
  x_loop
    mov r0, fbm2(U * 4.0 + 10.0, V * 4.0 + 10.0, 6.0)
    mov r1, fbm2(U * 4.0 + r0 * 2.0, V * 4.0 + r0 * 2.0, 5.0)
    mov r2, fbm2(U * 4.0 + 5.0 + r1 * 3.0, V * 4.0 + r1 * 3.0, 5.0)
    mov r3, 0.5 + 0.5 * sin(r2 * 8.0 + T)
    set_pixel X, Y, r0 * 0.6 + r3 * 0.4, r1 * 0.7 + r3 * 0.3, r2
  end
end
