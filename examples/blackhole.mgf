; blackhole.mgf — Schwarzschild black hole with a thin accretion disk.
;
; Per pixel: shoot a ray from a camera at r = 24 rs, integrate the null
; geodesic in Cartesian form
;
;     a = -1.5 * rs * h^2 * r_vec / r^5        (rs = 1, c = 1)
;
; with a leapfrog step. h is the conserved specific angular momentum
; |r x v|. The first crossing of the z=0 plane inside [3 rs, 12 rs] is
; the optically thick disk; otherwise the ray is captured (r < 1) or
; escapes to a procedural star field.
;
; Camera: inclination 12 degrees above the disk, r = 24 rs, vertical
; half-FOV = 18 degrees. Disk: Keplerian rotation, Doppler beaming,
; gravitational redshift, fbm turbulence and a soft inner glow.

canvas 960, 540

y_loop
  x_loop
    ; ---------------- camera ray --------------------------------------
    ; screen coords: sx in [-aspect, aspect], sy in [-1, 1] (up = +)
    mov r7, (U - 0.5) * 2.0 * (W / H)
    mov r8, (0.5 - V) * 2.0

    ; forward = (0, cos12, -sin12) = (0, 0.9781, -0.2079)
    ; right   = (1, 0, 0)
    ; up      = (0, sin12, cos12) = (0, 0.2079, 0.9781)
    ; tan(18 deg) = 0.32492
    mov r3, r7 * 0.32492
    mov r4, 0.9781 + 0.0676 * r8
    mov r5, -0.2079 + 0.3178 * r8

    mov r9, sqrt(r3 * r3 + r4 * r4 + r5 * r5)
    mov r3, r3 / r9
    mov r4, r4 / r9
    mov r5, r5 / r9

    ; camera at (0, -24 cos12, 24 sin12)
    mov r0, 0.0
    mov r1, -23.474
    mov r2, 4.990

    ; conserved h^2 = |r x v|^2
    mov r7, r1 * r5 - r2 * r4
    mov r8, r2 * r3 - r0 * r5
    mov r9, r0 * r4 - r1 * r3
    mov r6, r7 * r7 + r8 * r8 + r9 * r9

    ; ---------------- geodesic integration -----------------------------
    ; r13..r15 = position at the start of the current segment
    mov r13, r0
    mov r14, r1
    mov r15, r2

    repeat 360
      ; ---------------- leapfrog step --------------------------------
      ; acceleration at the old position
      mov r11, r0 * r0 + r1 * r1 + r2 * r2
      mov r12, sqrt(r11)
      mov r7, 0.025 * r12 + 0.010          ; adaptive affine step
      mov r8, -1.5 * r6 / (r11 * r11 * r12)
      mov r9, r8 * r0
      mov r10, r8 * r1
      mov r11, r8 * r2

      ; v += 0.5 dt a
      mov r3, r3 + 0.5 * r7 * r9
      mov r4, r4 + 0.5 * r7 * r10
      mov r5, r5 + 0.5 * r7 * r11

      ; x += dt v
      mov r0, r0 + r7 * r3
      mov r1, r1 + r7 * r4
      mov r2, r2 + r7 * r5

      ; acceleration at the new position
      mov r11, r0 * r0 + r1 * r1 + r2 * r2
      mov r12, sqrt(r11)
      mov r8, -1.5 * r6 / (r11 * r11 * r12)
      mov r9, r8 * r0
      mov r10, r8 * r1
      mov r11, r8 * r2

      ; v += 0.5 dt a
      mov r3, r3 + 0.5 * r7 * r9
      mov r4, r4 + 0.5 * r7 * r10
      mov r5, r5 + 0.5 * r7 * r11

      ; ---------------- segment checks --------------------------------
      mov r11, r0 * r0 + r1 * r1 + r2 * r2
      mov r12, sqrt(r11)                 ; r at the new point

      ; disk-plane crossing between (r13,r14,r15) and (r0,r1,r2)
      mov r11, r15 * r2
      if r11 < 0.0
        ; t = prev_z / (prev_z - z)
        mov r11, r15 / (r15 - r2)
        mov r7, r13 + (r0 - r13) * r11     ; x at z=0
        mov r8, r14 + (r1 - r14) * r11     ; y at z=0
        mov r9, sqrt(r7 * r7 + r8 * r8)    ; cylindrical radius

        if r9 > 3.0
          if r9 < 12.0
            ; ---------- disk emission --------------------------------
            ; radial coordinate u in [0,1] from ISCO to outer edge
            mov r10, (r9 - 3.0) / 9.0

            ; temperature colour: orange outside -> warm white inside
            mov r11, clamp(1.0 - r10, 0.0, 1.0)
            mov r11, r11 * r11
            mov r0, 1.0
            mov r1, 0.30 + 0.66 * r11
            mov r2, 0.05 + 0.83 * r11

            ; fine turbulence + azimuthal streaks
            mov r12, fbm2(r7 * 1.3 + 4.0, r8 * 1.3 - 2.0, 5)
            mov r12, 0.75 + 0.40 * r12
            mov r13, fbm2(r7 * 3.5 - 1.0, r8 * 3.5 + 3.0, 3)
            mov r12, r12 * (0.90 + 0.20 * r13)

            mov r13, atan2(r8, r7)
            mov r14, sin(r13 * 12.0 - r9 * 0.8 + r12 * 3.0)
            mov r13, 0.85 + 0.22 * r14
            mul r12, r13

            ; radial brightness + hot inner glow + soft outer fade
            mov r13, pow(3.0 / r9, 1.2)
            mul r13, 2.6
            mov r14, clamp(1.0 - (r9 - 3.0) / 0.9, 0.0, 1.0)
            mov r14, r14 * r14
            add r13, 1.10 * r14
            mov r14, clamp((12.0 - r9) / 2.5, 0.0, 1.0)
            mul r13, r14

            ; relativistic Doppler: v_los = -cos(i) * x / r
            mov r14, -0.9781 * r7 / r9
            mov r15, sqrt(0.5 / r9)          ; beta = sqrt(M/r), M = 0.5
            mul r15, r14
            mov r15, 1.0 / (1.0 - r15)       ; Doppler factor D
            mov r14, sqrt(1.0 - 1.0 / r9)    ; gravitational redshift
            mul r15, r14                     ; total shift
            mov r14, r15 * r15 * r15         ; beaming ~ shift^3
            mul r13, r14

            ; blue tint on the approaching side
            mov r14, clamp((r15 - 1.0) * 1.5, 0.0, 1.0)
            mul r14, 0.35
            mov r0, lerp(r0, 1.0, r14)
            mov r1, lerp(r1, 0.88, r14)
            mov r2, lerp(r2, 1.0, r14)

            ; final disk radiance
            mul r0, r13
            mul r0, r12
            mul r1, r13
            mul r1, r12
            mul r2, r13
            mul r2, r12

            mov r12, -1.0
            break
          end
        end
      end

      ; ---------------- event horizon ---------------------------------
      if r12 < 1.0
        mov r0, 0.0
        mov r1, 0.0
        mov r2, 0.0
        mov r12, -2.0
        break
      end

      ; ---------------- escape to infinity ----------------------------
      if r12 > 40.0
        mov r11, r0 * r3 + r1 * r4 + r2 * r5
        if r11 > 0.0
          mov r12, -3.0
          break
        end
      end

      ; this point becomes the start of the next segment
      mov r13, r0
      mov r14, r1
      mov r15, r2
    end

    ; ---------------- after the loop ----------------------------------
    ; r12 = -1 disk (colour already in r0..r2)
    ; r12 = -2 captured
    ; r12 = -3 escaped
    ; otherwise the ray never resolved: treat as captured.
    if r12 < -2.5
      ; escaped: star field + faint nebula
      mov r7, sqrt(r3 * r3 + r4 * r4 + r5 * r5)
      mov r3, r3 / r7
      mov r4, r4 / r7
      mov r5, r5 / r7

      mov r10, fbm2(r3 * 5.0 + 7.0, r4 * 5.0 - 3.0, 4)
      mov r11, fbm2(r3 * 11.0 - 2.0, r5 * 11.0 + 5.0, 3)
      mov r0, 0.004 + 0.020 * r10 + 0.008 * r11
      mov r1, 0.007 + 0.028 * r10 + 0.012 * r11
      mov r2, 0.018 + 0.055 * r10 + 0.025 * r11

      mov r10, noise2(r3 * 90.0 + 13.0, r4 * 90.0 - 7.0)
      mov r10, clamp((r10 - 0.985) * 80.0, 0.0, 1.0)
      mov r10, r10 * r10
      add r0, r10
      add r1, r10
      mov r11, r10 * 1.05
      add r2, r11

      mov r10, noise2(r3 * 170.0 - 4.0, r5 * 170.0 + 9.0)
      mov r10, clamp((r10 - 0.992) * 120.0, 0.0, 1.0)
      add r0, r10 * 0.8
      add r1, r10 * 0.8
      add r2, r10 * 0.9
    else if r12 < -1.5
      ; captured: pure black
      mov r0, 0.0
      mov r1, 0.0
      mov r2, 0.0
    else if r12 < -0.5
      ; disk hit: r0..r2 already hold the radiance
    else
      ; unresolved (near photon sphere, loop exhausted)
      mov r0, 0.0
      mov r1, 0.0
      mov r2, 0.0
      mov r12, -4.0
    end

    ; ---------------- smooth photon-ring glow -------------------------
    ; Higher-order disk images pile up near the critical impact
    ; parameter b_c = 3*sqrt(3)/2 = 2.598 rs. Add a smooth component
    ; where the near disk is not already in front of the shadow.
    if r12 < -1.5
      mov r10, sqrt(r6)
      mov r10, abs(r10 - 2.598)
      mov r10, clamp(1.0 - r10 / 0.075, 0.0, 1.0)
      mov r10, r10 * r10
      add r0, 0.55 * r10
      add r1, 0.40 * r10
      add r2, 0.26 * r10
    end

    ; 8-bit dither: break up gradient banding in the dark outer disk
    mov r10, noise2(X * 1.7 + 3.0, Y * 1.7 - 5.0) - 0.5
    mul r10, 0.004
    add r0, r10
    mov r10, noise2(X * 1.9 - 7.0, Y * 1.9 + 2.0) - 0.5
    mul r10, 0.004
    add r1, r10
    mov r10, noise2(X * 2.1 + 11.0, Y * 2.1 + 4.0) - 0.5
    mul r10, 0.004
    add r2, r10

    set_pixel X, Y, r0, r1, r2
  end
end
