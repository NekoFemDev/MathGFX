; branches.mgf — if / elif / else if / else chain, one closing end.

canvas 16, 16

y_loop
  x_loop
    mov r0, 0.0
    if U < 0.25
      mov r0, 1.0
    elif U < 0.5
      mov r0, 0.75
    else if U < 0.75
      mov r0, 0.5
    else
      mov r0, 0.25
    end
    set_pixel X, Y, r0, V, 0.5
  end
end
